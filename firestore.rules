rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function logado()   { return request.auth != null && perfil().ativo == true; }
    function ehDev()    { return logado() && perfil().role == 'DEV'; }
    function ehAdmin()  { return logado() && perfil().role == 'ADMIN'; }
    function ehGestor() { return logado() && perfil().role in ['ADMIN', 'DEV']; }

    // Perfis: o próprio usuário lê o seu; DEV lê todos; ADMIN lê só os de balcão.
    // Ninguém altera perfis pelo app (faça isso pelo Console do Firebase).
    match /usuarios/{uid} {
      allow get: if logado() && (
        request.auth.uid == uid || ehDev() ||
        (ehAdmin() && resource.data.role in ['BALCAO', 'ATENDENTE'])
      );
      allow list: if logado() && (
        ehDev() || (ehAdmin() && resource.data.role in ['BALCAO', 'ATENDENTE'])
      );
      allow write: if false;
    }

    // Pedidos: qualquer usuário ativo lança, paga e muda status; ninguém apaga.
    match /orders/{id} {
      allow read, create, update: if logado();
      allow delete: if false;
    }

    // Contador diário de comandas
    match /counters/{day} {
      allow read, create, update: if logado();
      allow delete: if false;
    }

    // Resumos mensais do Balanço: o balcão só grava (ao receber pagamento);
    // quem lê é apenas DEV/ADMIN.
    match /resumos/{mes} {
      allow read: if ehGestor();
      allow create, update: if logado();
      allow delete: if false;
    }

    // Todo o resto fica bloqueado
    match /{outro=**} {
      allow read, write: if false;
    }
  }
}
